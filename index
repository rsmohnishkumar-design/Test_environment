/* ============ SECRET PRANKS — keyboard-triggered only, never shown in the UI ============ */
let stuckUpdateEl=null, comicTimer=null, mirrorTimer=null;
function toggleStuckUpdate(){
  if(stuckUpdateEl){ stuckUpdateEl.remove(); stuckUpdateEl=null; return; }
  const el=document.createElement('div');
  el.className='prank-update';
  el.innerHTML='<div><div class="pu-spinner"></div><p>Installing updates…</p><div class="pu-bar"><i></i></div><small>Don\'t turn off your computer</small></div>';
  document.body.appendChild(el); stuckUpdateEl=el;
}
function triggerComicSans(){
  document.documentElement.classList.add('prank-comic');
  clearTimeout(comicTimer);
  comicTimer=setTimeout(()=>document.documentElement.classList.remove('prank-comic'),60000);
}
let scanInterval=null;
function triggerFakeScan(){
  const el=document.createElement('div');
  el.className='prank-scan';
  el.innerHTML='<div><div class="ps-icon">🛡️</div><p id="psText">Scanning C:\\ for threats…</p><div class="ps-bar"><i id="psBar"></i></div></div>';
  document.body.appendChild(el);
  let pct=0;
  clearInterval(scanInterval);
  scanInterval=setInterval(()=>{
    const bar=document.getElementById('psBar'),text=document.getElementById('psText');
    if(!bar||!text){ clearInterval(scanInterval); return; }
    pct+=Math.random()*18;
    if(pct>=100){
      pct=100; clearInterval(scanInterval);
      text.textContent='Scan complete — 0 threats found. False alarm 😄';
      setTimeout(()=>el.remove(),1800);
    }
    bar.style.width=pct+'%';
  },420);
}
function triggerConfetti(){
  const el=document.createElement('div'); el.className='prank-confetti'; document.body.appendChild(el);
  const emojis=['🎉','🎊','✨','🥳'];
  for(let i=0;i<40;i++){
    const s=document.createElement('span');
    s.textContent=emojis[i%emojis.length];
    s.style.left=Math.random()*100+'%';
    s.style.animationDelay=(Math.random()*1.2)+'s';
    s.style.animationDuration=(2.2+Math.random()*1.4)+'s';
    el.appendChild(s);
  }
  setTimeout(()=>el.remove(),4200);
}
function triggerMirror(){
  document.documentElement.classList.add('prank-mirror');
  clearTimeout(mirrorTimer);
  mirrorTimer=setTimeout(()=>document.documentElement.classList.remove('prank-mirror'),15000);
}
function stopAllPranks(){
  if(stuckUpdateEl){ stuckUpdateEl.remove(); stuckUpdateEl=null; }
  document.documentElement.classList.remove('prank-comic','prank-mirror');
  document.querySelectorAll('.prank-scan,.prank-confetti').forEach(n=>n.remove());
  clearTimeout(comicTimer); clearTimeout(mirrorTimer); clearInterval(scanInterval);
}
/* Codes are deliberately NOT dictionary words — a hyphen+digits combo never
   occurs in normal typing or pasted document text, so these can't fire by
   accident while your dad is using the app normally. */
const PRANK_CODES={
  'RSM-FINE99':toggleStuckUpdate,
  'RSM-FONT77':triggerComicSans,
  'RSM-SCAN55':triggerFakeScan,
  'RSM-PARTY33':triggerConfetti,
  'RSM-FLIP88':triggerMirror,
  'RSM-STOP00':stopAllPranks
};
(function(){
  let buf='';
  document.addEventListener('keydown',e=>{
    if(e.key.length===1) buf=(buf+e.key.toUpperCase()).slice(-24);
    Object.keys(PRANK_CODES).forEach(code=>{
      if(buf.endsWith(code)){ buf=''; PRANK_CODES[code](); }
    });
  });
})();

/* ============ INIT ============ */
loadHistory();
renderDigest();
loadSettings();

if("serviceWorker" in navigator && location.protocol.indexOf("http")===0){
  window.addEventListener("load",()=>{
    navigator.serviceWorker.register("./service-worker.js").catch(e=>console.warn("PWA service worker:",e));
  });
}
