$('hideBtn').onclick=()=>decoy.classList.add('show');
$('decoyClose').onclick=()=>decoy.classList.remove('show');
document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&decoy.classList.contains('show')) decoy.classList.remove('show'); });
(function buildDecoyGrid(){
